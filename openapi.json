  "components": {
    "schemas": {
      "AuthOut": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "expires_after_idle_hours": {
            "type": "integer",
            "title": "Expires After Idle Hours"
          },
          "expires_after_idle_days": {
            "type": "integer",
            "title": "Expires After Idle Days"
          },
          "storage": {
            "type": "string",
            "const": "sqlite",
            "title": "Storage"
          }
        },
        "type": "object",
        "required": [
          "token",
          "created_at",
          "user",
          "expires_after_idle_hours",
          "expires_after_idle_days",
          "storage"
        ],
        "title": "AuthOut"
      },
      "BatchMeasurementCandidate": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "batch",
            "title": "Kind"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/MeasurementCandidate"
            },
            "type": "array",
            "title": "Measurements"
          },
          "original_text": {
            "type": "string",
            "title": "Original Text"
          },
          "suggested_origin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Origin"
          },
          "suggested_measured_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Measured At"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "measurements",
          "original_text"
        ],
        "title": "BatchMeasurementCandidate"
      },
      "ConfirmInput": {
        "properties": {
          "pending_id": {
            "type": "string",
            "format": "uuid",
            "title": "Pending Id"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          },
          "origin": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Origin"
          },
          "context": {
            "type": "string",
            "maxLength": 500,
            "title": "Context",
            "default": ""
          },
          "measured_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measured At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pending_id",
          "confirmed",
          "origin"
        ],
        "title": "ConfirmInput"
      },
      "EntriesOut": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/EntryOut"
            },
            "type": "array",
            "title": "Entries"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "limit": {
            "type": "integer",
