# ==============================================================================
# Claves opcionales para interpretación con LLM y generación de recomendaciones
# (Soporta Groq, OpenAI o Gemini. Si no se configuran, la app usa su extractor determinista local).
# ==============================================================================

# Opción 1: Groq (Gratis, ultra-rápido, modelo Llama 3.3 70B)
# Obtén tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=

# Opción 2: OpenAI (Modelo GPT-4o-mini)
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opción 3: Google Gemini (Modelo Gemini 1.5 Flash)
# Obtén tu clave gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
